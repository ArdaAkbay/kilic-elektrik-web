# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# .env dosyası GitHub'a GÖNDERİLMEZ (.gitignore içinde). Render'da bu değerler "Environment" bölümüne girilir.

# Yerelde 3000; Render bunu kendisi verir, girmenize gerek yok
PORT=3000
# Canlıda "production" olmalı (güvenli çerez için)
NODE_ENV=development

# MongoDB Atlas bağlantı adresi (Atlas > Clusters > Connect > Drivers)
# <db_password> yerine veritabanı kullanıcısının şifresini yazın, ".net/" sonrasına veritabanı adını ekleyin
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/kilic-elektrik?retryWrites=true&w=majority

# Uzun ve rastgele bir metin. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usta paneli hesabı (veritabanında hiç kullanıcı yoksa ilk açılışta otomatik oluşturulur)
ADMIN_USERNAME=usta
ADMIN_PASSWORD=

# Yeni talep bildirimi (Resend > API Keys). Boş bırakılırsa site çalışır, sadece e-posta gitmez.
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=Kılıç Elektrik <onboarding@resend.dev>

# Sitenin canlı adresi (Google için kanonik adres, sitemap ve e-postadaki "panelde aç" linki)
SITE_URL=https://kilic-elektrik.onrender.com

# Google Ads (isteğe bağlı). Boş bırakılırsa sitede hiçbir reklam kodu ve çerez bandı olmaz.
# Google Ads > Hedefler > Dönüşümler bölümünde oluşturulan dönüşümlerden alınır.
# GOOGLE_ADS_ID=AW-123456789
# GOOGLE_ADS_TALEP_ETIKETI=
# GOOGLE_ADS_ARAMA_ETIKETI=

# İsteğe bağlı
# Aynı kişiden 10 dakikada kabul edilen en fazla talep sayısı (varsayılan 5)
# TALEP_SINIRI=5
# Test veritabanı TTL index desteklemiyorsa: interval. Atlas'ta boş bırakın.
# SESSION_AUTO_REMOVE=native
