<%- include('../partials/admin-ust') %>

<form class="giris-kutu form" method="post" action="/admin/giris">
  <h1>Usta girişi</h1>
  <% if (hata) { %><p class="bilgi hata" role="alert"><%= hata %></p><% } %>
  <div class="alan">
    <label for="kullaniciAdi">Kullanıcı adı</label>
    <input id="kullaniciAdi" name="kullaniciAdi" type="text" autocomplete="username" autocapitalize="none" required value="<%= kullaniciAdi %>">
  </div>
  <div class="alan">
    <label for="sifre">Şifre</label>
    <input id="sifre" name="sifre" type="password" autocomplete="current-password" required>
  </div>
  <button class="btn birincil" type="submit">Giriş yap</button>
  <a class="ikincil" href="/">Siteye dön</a>
</form>

<%- include('../partials/admin-alt') %>
