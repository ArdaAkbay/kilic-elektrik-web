<%- include('../partials/admin-ust') %>
<% const yeni = !hizmet._id; const sinif = (a) => hatalar[a] ? 'alan hatali' : 'alan';
   const isaretli = (v) => v === true || v === 'on' || v === 'true';
   const kapi = hizmet.kapi || 'proje'; %>

<div class="panel-bas">
  <div>
    <p class="ikincil"><a href="/admin/hizmetler">Hizmetler</a> / <%= yeni ? 'Yeni' : hizmet.ad %></p>
    <h1><%= baslik %></h1>
  </div>
</div>

<form class="form panel-form" method="post" action="<%= yeni ? '/admin/hizmetler' : `/admin/hizmetler/${hizmet._id}?_method=PUT` %>" enctype="multipart/form-data" novalidate>
  <%- include('../partials/form-ozeti', { hatalar, dosyaUyarisi: Boolean(hatalar.fotograf) }) %>

  <div class="<%= sinif('kapi') %>">
    <span class="etiket" id="kapi-etiket">Nerede görünsün?</span>
    <div class="kapi-secim" role="radiogroup" aria-labelledby="kapi-etiket">
      <label class="secim"><input type="radio" name="kapi" value="proje" id="kapi" <% if (kapi === 'proje') { %>checked<% } %>><span><b>Proje hizmeti</b><br><span class="ikincil">Fotoğraflı kart ve kendi sayfası</span></span></label>
      <label class="secim"><input type="radio" name="kapi" value="ev" <% if (kapi === 'ev') { %>checked<% } %>><span><b>Ev hizmeti</b><br><span class="ikincil">"Evim için" listesi ve ev formu</span></span></label>
    </div>
    <%- include('../partials/alan-hatasi', { alan: 'kapi' }) %>
  </div>

  <div class="satir">
    <div class="<%= sinif('ad') %>">
      <label for="ad">Hizmet adı</label>
      <input id="ad" name="ad" type="text" required maxlength="60" value="<%= hizmet.ad || '' %>" placeholder="Örn. Fabrika aydınlatma">
      <%- include('../partials/alan-hatasi', { alan: 'ad' }) %>
    </div>
    <div class="<%= sinif('grup') %>">
      <label for="grup">Grup <span class="istege-bagli">(proje hizmetleri için)</span></label>
      <select id="grup" name="grup">
        <% sabitler.HIZMET_GRUPLARI.forEach((g) => { %><option value="<%= g.value %>"<% if (hizmet.grup === g.value) { %> selected<% } %>><%= g.label %></option><% }) %>
      </select>
      <%- include('../partials/alan-hatasi', { alan: 'grup' }) %>
    </div>
  </div>

  <div class="<%= sinif('kisaAciklama') %>">
    <label for="kisaAciklama">Kısa açıklama</label>
    <span class="ipucu">Kartta ve Google arama sonuçlarında görünür. Tek cümle, en fazla 160 karakter.</span>
    <input id="kisaAciklama" name="kisaAciklama" type="text" required maxlength="160" value="<%= hizmet.kisaAciklama || '' %>">
    <%- include('../partials/alan-hatasi', { alan: 'kisaAciklama' }) %>
  </div>

  <div class="<%= sinif('aciklama') %>">
    <label for="aciklama">Uzun açıklama <span class="istege-bagli">(proje hizmetinin sayfasında görünür)</span></label>
    <textarea id="aciklama" name="aciklama" maxlength="1200"><%= hizmet.aciklama || '' %></textarea>
    <%- include('../partials/alan-hatasi', { alan: 'aciklama' }) %>
  </div>

  <div class="<%= sinif('fotograf') %>">
    <span class="etiket" id="foto-etiket">Fotoğraf <span class="istege-bagli">(proje hizmetleri için önerilir)</span></span>
    <% if (hizmet.gorsel && hizmet.gorsel.url) { %>
      <div class="mevcut-foto">
        <img src="<%= hizmet.gorsel.kucukUrl || hizmet.gorsel.url %>" alt="Şu anki fotoğraf">
        <div style="display:grid;gap:8px">
          <span class="ikincil">Şu anki fotoğraf. Yeni bir fotoğraf seçerseniz bunun yerine geçer.</span>
          <label class="onay"><input type="checkbox" name="fotografiKaldir"><span>Fotoğrafı kaldır</span></label>
        </div>
      </div>
    <% } %>
    <div class="dosya-kutu">
      <input id="fotograf" name="fotograf" type="file" accept="image/jpeg,image/png,image/webp" data-onizleme="foto-onizleme" data-max="1" data-max-mb="10" aria-labelledby="foto-etiket">
      <span class="ipucu">Yatay çekilmiş bir fotoğraf en iyi sonucu verir. Fotoğraf otomatik olarak küçültülür.</span>
      <div class="onizleme" id="foto-onizleme"></div>
    </div>
    <%- include('../partials/alan-hatasi', { alan: 'fotograf' }) %>
  </div>

  <div class="satir">
    <div class="<%= sinif('sira') %>">
      <label for="sira">Sıra</label>
      <span class="ipucu">Küçük sayı listede önce görünür.</span>
      <input id="sira" name="sira" type="number" min="0" max="999" value="<%= hizmet.sira ?? '' %>">
      <%- include('../partials/alan-hatasi', { alan: 'sira' }) %>
    </div>
    <div class="alan" style="align-self:end;gap:12px">
      <label class="onay"><input type="checkbox" name="aktif"<% if (isaretli(hizmet.aktif)) { %> checked<% } %>><span>Sitede göster</span></label>
      <label class="onay"><input type="checkbox" name="oneCikan"<% if (isaretli(hizmet.oneCikan)) { %> checked<% } %>><span>Ana sayfada öne çıkar (proje hizmetleri)</span></label>
    </div>
  </div>

  <div class="form-alt">
    <a class="ikincil" href="/admin/hizmetler">Vazgeç</a>
    <button class="btn birincil" type="submit" data-gonder="Kaydediliyor…"><%= yeni ? 'Hizmeti ekle' : 'Değişiklikleri kaydet' %></button>
  </div>
</form>

<%- include('../partials/admin-alt') %>
