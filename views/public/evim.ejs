<%- include('../partials/ust') %>

<div class="sayfa-bas">
  <div class="wrap">
    <p class="yol"><a href="/">Ana sayfa</a> / Evim için</p>
    <h1>Evim için</h1>
    <p class="giris">Evde ve küçük iş yerlerinde yaptığımız işler aşağıda. Hizmeti seçin, arızanın ya da yerin fotoğrafını gönderin; ustamız inceleyip sizi arasın.</p>
  </div>
</div>
<div class="tava ince" role="presentation"></div>

<section style="padding-top:36px">
  <div class="wrap">
    <p class="not-kutu">Fiyatı keşiften sonra, iş başlamadan önce söyleriz. Sürpriz ücret çıkmaz.</p>
    <% if (hizmetler.length) { %>
      <ul class="liste">
        <% hizmetler.forEach((h) => { %>
          <li>
            <h3><%= h.ad %></h3>
            <% if (h.kisaAciklama) { %><p><%= h.kisaAciklama %></p><% } %>
            <a class="btn cerceve kucuk" href="/evim/talep?hizmet=<%= encodeURIComponent(h.slug) %>">Talep oluştur</a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="bos"><h3>Hizmet listesi güncelleniyor</h3><p>İşinizi anlatmak için bizi arayın: <%= isletme.phoneDisplay %></p></div>
    <% } %>
    <div class="eylemler" style="margin-top:36px">
      <a class="btn birincil" href="/evim/talep">Ev talebi oluştur</a>
      <span class="ikincil">İşiniz listede yoksa "Arıza tespiti ve onarım"ı seçip anlatın.</span>
    </div>
  </div>
</section>

<%- include('../partials/alt') %>
