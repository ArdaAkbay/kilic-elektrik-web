<%- include('../partials/ust') %>

<div class="sayfa-bas">
  <div class="wrap dar">
    <h1>Talebiniz alındı</h1>
    <p class="giris"><%= ozet.baslik %> talebiniz ustamıza ulaştı. Sizi verdiğiniz numaradan arayacağız.</p>
  </div>
</div>

<section style="padding-top:36px">
  <div class="wrap dar" style="display:grid;gap:48px">
    <div class="kod-kutu">
      <span class="ikincil">Takip kodunuz</span>
      <span class="kod"><%= ozet.takipKodu %></span>
      <p class="ikincil">Bu kodu not alın ya da ekran görüntüsünü kaydedin. Talebinizin hangi aşamada olduğunu bu kodla görebilirsiniz.</p>
      <div class="eylemler">
        <button class="btn cerceve kucuk" type="button" data-kopyala="<%= ozet.takipKodu %>">Kodu kopyala</button>
        <a class="btn cerceve kucuk" href="/takip?kod=<%= ozet.takipKodu %>">Durumu görüntüle</a>
        <a class="btn cerceve kucuk" href="<%= waLink(`Merhaba, ${ozet.takipKodu} numaralı talebim hakkında yazıyorum.`) %>" target="_blank" rel="noopener">WhatsApp'tan yaz</a>
      </div>
    </div>

    <div style="display:grid;gap:24px">
      <h2>Bundan sonra ne olacak?</h2>
      <ol class="adimlar">
        <li><h3>İnceleme</h3><p>Ustamız açıklamanızı ve dosyalarınızı inceler.</p></li>
        <li><h3>Arama</h3><p>Sizi arar, keşif için gün belirlenir.</p></li>
        <li><h3>Teklif</h3><p>Keşiften sonra net fiyat verilir.</p></li>
        <li><h3>Teslim</h3><p>İş biter, takip sayfanızda "Tamamlandı" görünür.</p></li>
      </ol>
    </div>
  </div>
</section>

<%- include('../partials/alt') %>
