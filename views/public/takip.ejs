<%- include('../partials/ust') %>

<div class="wrap dar">
  <div class="sayfa-bas">
    <p class="yol"><a href="/">Ana sayfa</a> / Talep takibi</p>
    <h1>Talebiniz ne durumda?</h1>
    <p class="giris">Talep oluşturduğunuzda verilen kodu yazın. Bu sayfada kişisel bilgileriniz gösterilmez, yalnızca talebin aşaması görünür.</p>
  </div>

  <form class="takip-form" method="get" action="/takip" role="search">
    <label class="sr-only" for="kod">Takip kodu</label>
    <input id="kod" name="kod" type="text" placeholder="KE-2026-0001" value="<%= kod %>" autocomplete="off" required pattern="[Kk][Ee]-\d{4}-\d{4,}" title="KE-2026-0001 biçiminde">
    <button class="btn primary" type="submit">Sorgula</button>
  </form>
  <% if (hata) { %><p class="hata-mesaj" role="alert" style="margin-top:12px"><%= hata %></p><% } %>

  <% if (ozet) { %>
    <% const iptal = ozet.durum === 'iptal';
       const asamalar = sabitler.DURUMLAR.filter((d) => d.value !== 'iptal');
       const gecmis = {}; ozet.durumGecmisi.forEach((g) => { gecmis[g.durum] = g.tarih; });
       const simdikiSira = asamalar.findIndex((a) => a.value === ozet.durum); %>
    <section aria-labelledby="sonuc-baslik">
      <div class="kod-kutu" style="margin-bottom:32px">
        <span class="muted"><%= ozet.tur === 'ev' ? 'Ev talebi' : 'Proje talebi' %> · <%= tarih(ozet.olusturma) %></span>
        <span class="kod" id="sonuc-baslik"><%= ozet.takipKodu %></span>
        <p><b><%= ozet.baslik %></b></p>
      </div>
      <ol class="cizelge">
        <% asamalar.forEach((a, i) => {
             const gecti = !iptal ? i <= simdikiSira : Boolean(gecmis[a.value]);
             const simdi = !iptal && i === simdikiSira; %>
          <li class="<%= gecti ? 'gecti' : '' %> <%= simdi ? 'simdi' : '' %>"<% if (simdi) { %> aria-current="step"<% } %>>
            <span class="nokta" aria-hidden="true"></span>
            <div>
              <h3><%= a.label %></h3>
              <% if (gecmis[a.value]) { %><time datetime="<%= new Date(gecmis[a.value]).toISOString() %>"><%= tarih(gecmis[a.value], true) %></time><% } %>
              <% if (simdi) { %><p><%= a.aciklama %></p><% } %>
            </div>
          </li>
        <% }) %>
        <% if (iptal) { %>
          <li class="iptal simdi" aria-current="step">
            <span class="nokta" aria-hidden="true"></span>
            <div>
              <h3>İptal edildi</h3>
              <% if (gecmis.iptal) { %><time><%= tarih(gecmis.iptal, true) %></time><% } %>
              <p><%= sabitler.DURUMLAR.find((d) => d.value === 'iptal').aciklama %></p>
            </div>
          </li>
        <% } %>
      </ol>
      <p class="muted">Sorunuz mu var? <a href="<%= waLink(`Merhaba, ${ozet.takipKodu} numaralı talebim hakkında yazıyorum.`) %>" target="_blank" rel="noopener">WhatsApp'tan yazın</a> ya da arayın: <%= isletme.phoneDisplay %></p>
    </section>
  <% } %>
</div>

<%- include('../partials/alt') %>
