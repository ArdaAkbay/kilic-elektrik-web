<%
  const sayfaBasligi = baslik ? `${baslik} | ${isletme.name}` : `${isletme.name} | Elektrik tesisatı ve aydınlatma, Bağcılar İstanbul`;
  const sayfaAciklamasi = typeof aciklama !== 'undefined' && aciklama
    ? aciklama
    : 'Kılıç Elektrik: fabrika, depo, mağaza ve konutlar için elektrik tesisatı, aydınlatma, kablo tava ve topraklama. Bağcılar, İstanbul.';
  const kanonik = siteAdresi + yol;
  const paylasimGorseli = siteAdresi + (typeof ogGorsel !== 'undefined' && ogGorsel ? ogGorsel : '/img/hizmetler/yuksek-tavan-aydinlatma.jpg');
  const menu = [['/hizmetler', 'Hizmetlerimiz'], ['/projem', 'Projem için'], ['/evim', 'Evim için'], ['/isler', 'Yaptığımız işler'], ['/takip', 'Talep takibi']];
%><!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= sayfaBasligi %></title>
  <meta name="description" content="<%= sayfaAciklamasi %>">
  <link rel="canonical" href="<%= kanonik %>">
  <meta name="theme-color" content="#13213a">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="tr_TR">
  <meta property="og:site_name" content="<%= isletme.name %>">
  <meta property="og:title" content="<%= sayfaBasligi %>">
  <meta property="og:description" content="<%= sayfaAciklamasi %>">
  <meta property="og:url" content="<%= kanonik %>">
  <meta property="og:image" content="<%= paylasimGorseli %>">
  <link rel="icon" href="/img/logo-koyu.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/site.js" defer></script>
  <% if (reklam.id) { %><script src="/js/reklam.js" defer data-ads-id="<%= reklam.id %>" data-talep-etiketi="<%= reklam.talepEtiketi %>" data-arama-etiketi="<%= reklam.aramaEtiketi %>"></script><% } %>
  <%- include('yerel-isletme') %>
</head>
<body<% if (typeof donusumSayfasi !== 'undefined' && donusumSayfasi && typeof ozet !== 'undefined') { %> data-donusum="talep" data-takip-kodu="<%= ozet.takipKodu %>"<% } %>>
<a class="atla" href="#icerik">İçeriğe geç</a>
<header class="top">
  <div class="wrap">
    <a class="marka" href="/"><img src="/img/logo-koyu.png" alt="" width="42" height="36"><span>KILIÇ ELEKTRİK<small>Elektrik tesisatı ve aydınlatma</small></span></a>
    <nav class="menu" id="menu" aria-label="Ana menü">
      <% menu.forEach(([href, ad]) => { %>
        <a href="<%= href %>"<% if (yol === href || yol.startsWith(href + '/')) { %> aria-current="page"<% } %>><%= ad %></a>
      <% }) %>
    </nav>
    <a class="ara-btn" href="tel:+<%= isletme.phoneIntl %>" aria-label="Ara: <%= isletme.phoneDisplay %>"><span class="tam"><%= isletme.phoneDisplay %></span><span class="kisa">Ara</span></a>
    <button class="menu-btn" type="button" aria-controls="menu" aria-expanded="false" data-menu-btn>Menü</button>
  </div>
</header>
<main id="icerik">
<% if (bilgi) { %><div class="wrap"><div class="bilgi <%= bilgi.tur %>" role="status"><%= bilgi.metin %></div></div><% } %>
